#!/bin/bash

source $HOME/.config/maddles/maddles.conf

lowercase() {
    echo "$(echo "$@" | tr '[:upper:]' '[:lower:]')";
}

[[ -z "$1" ]] && exit 2

exc="${!#}"

if [ ! -f "$(realpath -q "$exc")" ]; then
    echo ""
    echo "$(tput setaf 1)fatal: Executable does not exist or is missing$(tput sgr0)"
    exit 1
fi

args=( "${@:1:$#-1}" )
idx=0

while [ $idx -lt ${#args[@]} ]; do
    case "$(lowercase "${args[$idx]}")" in
        "--version"|"-v")
            dump+=("Version=${args[$((++idx))]}")
        ;;
        "--name"|"-n")
            dump+=("Name=${args[$((++idx))]}")
            name="${args[$idx]}"
        ;;
        "--generic-name"|"-g")
            dump+=("GenericName=${args[$((++idx))]}")
        ;;
        "--icon"|"-i")
            dump+=("Icon=${args[$((++idx))]}")
        ;;
        "--type"|"-t")
            dump+=("Type=${args[$((++idx))]}")
        ;;
        "--keywords"|"-k")
            while [[ "${args[$((++idx))]}" != "-"*  && $idx -lt $((${#args[$idx]}-1)) ]]; do
                keywords+=(${args[$idx]});
            done
            dump+=("Keywords=$(echo ${keywords[*]} | sed "s/ /;/g")")
            ((idx--))
        ;;
        "--categories"|"-c")
            while [[ "${args[$((++idx))]}" != "-"* && $idx -lt $((${#args[$idx]}-1)) ]]; do
                categories+=(${args[$idx]});
            done
            dump+=("Categories=$(echo ${categories[*]} | sed "s/ /;/g")")
            ((idx--))
        ;;
        "--no-move"|"-m")
            NoMove=1
        ;;
        "--help"|"-h")
            exit 2
        ;;
    esac
    ((idx++))
done

if [[ ${dump[@]} != *"Type="* ]]; then
    dump+=("Type=Application")
fi
if [[ -z "$name" ]]; then
    name=${exc##*/}
    name=${name%.*}
    dump+=("Name=$name")
fi

if [[ -z "$NoMove"  ]]; then
    dump+=("Exec=$(realpath "$exc")")
else 
    mv "$(realpath "$exc")" "~/.local/share/applications/bin"
    dump+=("Exec=~/.local/share/applications/bin/${exc##*/}")
fi


touch "$HOME/.local/share/applications/$name.desktop"
echo "[Desktop Entry]"$'\n'"$(echo ${dump[*]} | sed "s/ /\n/g")"$'\n'"# generated by maddles util" > "$HOME/.local/share/applications/$name.desktop"
